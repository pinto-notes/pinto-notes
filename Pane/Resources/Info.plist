<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PANE_DISPLAY_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Evernote export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.evernote.enex</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PANE_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.emilwagman.pane.connect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PANE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>chatgpt</string>
		<string>claude</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>Pinto Notes reads the Apple Notes you choose to import. It never changes them.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pinto Notes uses the camera to scan the code on a device you add.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Pinto Notes uses Face ID to open your locked notes, show your recovery key, approve AI connections and add a device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pinto Notes saves a picture to your photo library when you choose Save Image in the share sheet.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>dev.emilwagman.pane.connect</string>
	</array>
	<key>PaneAccent</key>
	<string>$(PANE_ACCENT)</string>
	<key>PaneAppGroup</key>
	<string>$(PANE_APP_GROUP)</string>
	<key>PaneAuthHost</key>
	<string>$(PANE_AUTH_HOST)</string>
	<key>PaneBundleID</key>
	<string>$(PANE_BUNDLE_ID)</string>
	<key>PaneMCPURL</key>
	<string>$(PANE_MCP_URL)</string>
	<key>PanePostHogHost</key>
	<string>$(PANE_POSTHOG_HOST)</string>
	<key>PanePostHogKey</key>
	<string>$(PANE_POSTHOG_KEY)</string>
	<key>PaneShareURL</key>
	<string>$(PANE_SHARE_URL)</string>
	<key>PaneSupabaseKey</key>
	<string>$(PANE_SUPABASE_KEY)</string>
	<key>PaneSupabaseURL</key>
	<string>$(PANE_SUPABASE_URL)</string>
	<key>PaneURLScheme</key>
	<string>$(PANE_URL_SCHEME)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Pane item</string>
			<key>UTTypeIdentifier</key>
			<string>dev.emilwagman.pane.item</string>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Evernote export</string>
			<key>UTTypeIdentifier</key>
			<string>com.evernote.enex</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>enex</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/enex+xml</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
