<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Amber Notes Beta for Mac (Developer ID, Config/Beta.xcconfig). Sandboxed so it gets a container
     of its own: the Mac download isn't sandboxed and keeps its store and files in
     ~/Library/Application Support, which a second unsandboxed copy would open too.
     Only entitlements Developer ID allows without a provisioning profile. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array><string>com.apple.Notes</string></array>
	<!-- Checklist ticks and pins from an Apple Notes import: Notes keeps them only in its own
	     database. Read-only, and still only once the person turns on Full Disk Access
	     (AppleNoteStore copies the database, reads it and deletes the copy). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array><string>/Library/Group Containers/group.com.apple.notes/</string></array>
	<key>com.apple.security.print</key>
	<true/>
	<!-- What a note that is an app can ask for (each asks the person first). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
